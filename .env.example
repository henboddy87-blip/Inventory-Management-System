# Database Configuration
# Default is SQLite for quick local development; can switch to PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sme_inventory
DATABASE_URL=sqlite:///./inventory.db

# Security & Authentication
SECRET_KEY=cambodian_sme_inventory_secret_key_change_in_production_2026_super_secure!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Settings
APP_NAME=SME Inventory Pro (Cambodian Edition)
DEBUG=True
ENVIRONMENT=development

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Cambodian Business Defaults
DEFAULT_CURRENCY=USD
EXCHANGE_RATE_KHR=4100.0
BUSINESS_NAME=Khmer Style Fashion
BUSINESS_PHONE=+855 23 888 999
BUSINESS_PROVINCE=Phnom Penh

# Telegram Notifications (Optional Integration)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
